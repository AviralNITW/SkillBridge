# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Postgres)
# Use 'db' instead of 'localhost' when running inside Docker Compose
DATABASE_URL="postgresql://skillbridge_user:skillbridge_password@localhost:5432/skillbridge_dev?schema=public"

# Cache Configuration (Redis)
# Use 'redis' instead of 'localhost' when running inside Docker Compose
REDIS_URL="redis://localhost:6379"

# Security Configuration
JWT_SECRET="super_secret_jwt_key_for_dev_change_in_prod"
JWT_EXPIRES_IN="7d"

# AWS S3 Storage Config (Optional for Local Setup)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="skillbridge-dev-bucket"

# Email Configuration (SMTP / Resend / SendGrid)
EMAIL_API_KEY="your-email-service-api-key"
EMAIL_FROM="no-reply@skillbridge.com"
