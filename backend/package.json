{
  "name": "skillbridge-backend",
  "version": "1.0.0",
  "description": "TypeScript Node.js Backend API for SkillBridge SaaS Platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "test:auth": "ts-node-dev --transpile-only src/modules/auth/tests/auth.test.ts",
    "test:students": "ts-node-dev --transpile-only src/modules/students/tests/student.test.ts",
    "test:organizations": "ts-node-dev --transpile-only src/modules/organizations/tests/organization.test.ts",
    "test:opportunities": "ts-node-dev --transpile-only src/modules/opportunities/tests/opportunity.test.ts",
    "test:applications": "ts-node-dev --transpile-only src/modules/applications/tests/application.test.ts",
    "test:tasks": "ts-node-dev --transpile-only src/modules/tasks/tests/task.test.ts",
    "test:assessments": "ts-node-dev --transpile-only src/modules/assessments/tests/assessment.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "redis": "^6.0.0",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.2",
    "@types/ua-parser-js": "^0.7.39",
    "prisma": "^5.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
